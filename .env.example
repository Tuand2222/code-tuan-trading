# Public URL and a random secret of at least 32 bytes.
BETTER_AUTH_URL=https://trading-plan-pro.tuann7260.chatgpt.site
BETTER_AUTH_SECRET=
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# OAuth applications. Never expose the *_CLIENT_SECRET values in client code.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Optional Cloudflare Turnstile protection.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional password-reset delivery through Resend.
RESEND_API_KEY=
AUTH_EMAIL_FROM=Trading Plan Pro <no-reply@example.com>

# Existing broker credential encryption key (base64-encoded 32 bytes).
BROKER_ENCRYPTION_KEY=
