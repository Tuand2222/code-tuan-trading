{
  "name": "trading-plan-pro",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test:trading": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "install:ci": "node scripts/verified-platform.mjs install",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "node scripts/verified-platform.mjs build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run test:trading && npm run typecheck && npm run build && node --experimental-strip-types --experimental-loader ./scripts/cloudflare-validation-loader.mjs --test tests/*.test.mjs",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate",
    "ci:check": "node scripts/ci-check.mjs"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "@types/papaparse": "^5.5.2",
    "better-auth": "1.6.23",
    "decimal.js": "^10.6.0",
    "dexie": "^4.4.6",
    "drizzle-orm": "0.45.2",
    "fflate": "^0.8.2",
    "lightweight-charts": "5.2.0",
    "lucide-react": "^1.29.0",
    "next": "16.2.6",
    "papaparse": "^5.7.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.7.284",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "xlsx-js-style": "1.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "fake-indexeddb": "^6.2.6",
    "fast-check": "^4.10.2",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "vitest": "^5.0.5",
    "wrangler": "4.92.0",
    "esbuild": "0.28.0"
  },
  "type": "module",
  "displayName": "Trading Plan Pro"
}
